# Claw Team — 复制为 .env 后填写；./platform/deploy.sh 也会在无 .env 时从本文件生成一份

# ========== Matrix Homeserver（Tuwunel）==========
# MXID 域名（@user:域名）；与 Element 服务器名一致。变量名沿用历史以便 openclaw / 脚本少改。
# https://github.com/matrix-construct/tuwunel
SYNAPSE_SERVER_NAME=localhost
# Tuwunel registration_token；须与 docker-compose 中 TUWUNEL_REGISTRATION_TOKEN 一致（deploy 已绑定此变量）
SYNAPSE_REGISTRATION_SHARED_SECRET=a-secret-key-change-in-production
SYNAPSE_PORT=8008
# 可选：Tuwunel 联邦（本地默认 false）
# TUWUNEL_ALLOW_FEDERATION=false

# ========== OpenClaw / LLM（容器通过 env_file 注入；须为真实 Key）==========
# 官方 Anthropic：只填下面两行即可（不要设 ANTHROPIC_BASE_URL）
# ANTHROPIC_API_KEY=sk-ant-api03-...
# MODEL_NAME=claude-sonnet-4-20250514
# 若同时设置 ANTHROPIC_BASE_URL，且模型名不是 claude- 开头，脚本会改用 OpenClaw 的 minimax 提供方（避免 Unknown model: anthropic/xxx）。
#
# MiniMax 国内 Anthropic 兼容（测试）：见 https://platform.minimaxi.com/docs/api-reference/text-anthropic-api
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# ANTHROPIC_API_KEY=你的_MiniMax_开放平台_API_Key
# MODEL_NAME=MiniMax-M2.1
ANTHROPIC_API_KEY=sk-ant-api03-替换为你的真实密钥
MODEL_NAME=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=

# ========== Matrix 账号密码（建议在 MVP 全部显式设置）==========
# Human（Element 登录）
HUMAN_USERNAME=human
HUMAN_PASSWORD=change_me_in_production

# 各 Agent 的 Matrix 密码；若留空，首次启动时脚本会随机生成并写入 volumes/openclaw/.agent-passwords
MANAGER_PASSWORD=change_me_in_production
ARCH_PASSWORD=change_me_in_production
DEV_PASSWORD=change_me_in_production
QA_PASSWORD=change_me_in_production
SRE_PASSWORD=change_me_in_production
RESEARCH_PASSWORD=change_me_in_production

# ========== 可选：团队房间（按项目命名）==========
# PROJECT_NAME 优先作为房间显示名；未设置则用 TEAM_ROOM_NAME；均未设则为「Claw Team」
# PROJECT_NAME=我的产品
TEAM_ROOM_NAME="Claw Team"
# 若已手动建好群，可写死房间 ID（一般留空，由 OpenClaw 启动脚本自动建群并邀请全员）
# MATRIX_ROOM_ID=!xxxx:localhost

# ========== Docker ==========
COMPOSE_PROJECT_NAME=clawteam
