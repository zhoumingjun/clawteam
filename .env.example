# Claw Team 配置
# cp .env.example .env && make fresh

# ===== 必须修改 =====
ANTHROPIC_API_KEY=替换为你的真实密钥

# ===== 本地开发可保持默认 =====

# LLM
MODEL_NAME=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=              # 非 Anthropic 网关时设置（如 MiniMax）

# Matrix Homeserver (Tuwunel)
MATRIX_SERVER_NAME=localhost
MATRIX_PORT=8008
MATRIX_REGISTRATION_TOKEN=a-secret-key-change-in-production
# TUWUNEL_ALLOW_FEDERATION=false

# Human 账号（Element 登录）
HUMAN_USERNAME=human
HUMAN_PASSWORD=change_me_in_production

# Agent 密码（留空则首次启动自动生成）
MANAGER_PASSWORD=change_me_in_production
ARCH_PASSWORD=change_me_in_production
DEV_PASSWORD=change_me_in_production
QA_PASSWORD=change_me_in_production
SRE_PASSWORD=change_me_in_production
RESEARCH_PASSWORD=change_me_in_production

# 团队房间
TEAM_ROOM_NAME=Claw Team
# MATRIX_ROOM_ID=              # 已有房间时设置

# Docker
COMPOSE_PROJECT_NAME=clawteam
