# Claw Team 环境变量配置
# 复制此文件为 .env 并填写实际值

# ============================================
# Synapse Matrix 配置
# ============================================
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_REGISTRATION_SHARED_SECRET=a-secret-key-change-in-production
SYNAPSE_ENABLE_REGISTRATION=true

# ============================================
# Agent API Keys (各 Agent 独立配置)
# ============================================
# Manager Agent
MANAGER_API_KEY=sk-ant-xxxxx
MANAGER_PASSWORD=change_me_in_production

# Arch Agent
ARCH_API_KEY=sk-ant-xxxxx
ARCH_PASSWORD=change_me_in_production

# Dev Agent
DEV_API_KEY=sk-ant-xxxxx
DEV_PASSWORD=change_me_in_production

# QA Agent
QA_API_KEY=sk-ant-xxxxx
QA_PASSWORD=change_me_in_production

# SRE Agent
SRE_API_KEY=sk-ant-xxxxx
SRE_PASSWORD=change_me_in_production

# Research Agent
RESEARCH_API_KEY=sk-ant-xxxxx
RESEARCH_PASSWORD=change_me_in_production

# ============================================
# Human 用户配置 (Matrix 账号)
# ============================================
HUMAN_USERNAME=human
HUMAN_PASSWORD=change_me_in_production

# ============================================
# OpenClaw 配置
# ============================================
OPENCLAW_VERSION=latest
OPENCLAW_CONFIG_PATH=/openclaw/config
OPENCLAW_DATA_PATH=/openclaw/data

# ============================================
# OpenClaw Agent Manager 配置
# ============================================
OPENCLAW_API_KEY=your-openclaw-api-key
OPENCLAW_AGENT_ID=openclaw-agent
OPENCLAW_AGENT_PASSWORD=change_me_in_production
OPENCLAW_MATRIX_HOMESERVER=http://synapse:8008
OPENCLAW_REGISTRATION_SHARED_SECRET=a-secret-key-change-in-production
OPENCLAW_ADMIN_USER=synapse_admin
OPENCLAW_ADMIN_PASSWORD=change_me_in_production

# ============================================
# Docker 配置
# ============================================
COMPOSE_PROJECT_NAME=clawteam
COMPOSE_FILE=docker-compose.yml

# ============================================
# 网络配置
# ============================================
SYNAPSE_PORT=8008
ELEMENT_PORT=10001
