# Claw Team 环境变量配置
# 复制此文件为 .env 并填写实际值

# ============================================
# Matrix / Conduit 配置
# ============================================
CONDUIT_SERVER=localhost:10000
CONDUIT_DATABASE_PATH=/data/conduit.db

# ============================================
# Agent API Keys (各 Agent 独立配置)
# ============================================
# Manager Agent
MANAGER_API_KEY=sk-ant-xxxxx

# Arch Agent
ARCH_API_KEY=sk-ant-xxxxx

# Dev Agent
DEV_API_KEY=sk-ant-xxxxx

# QA Agent
QA_API_KEY=sk-ant-xxxxx

# SRE Agent
SRE_API_KEY=sk-ant-xxxxx

# Research Agent
RESEARCH_API_KEY=sk-ant-xxxxx

# ============================================
# OpenClaw 配置
# ============================================
OPENCLAW_VERSION=latest
OPENCLAW_CONFIG_PATH=/openclaw/config
OPENCLAW_DATA_PATH=/openclaw/data

# ============================================
# Docker 配置
# ============================================
COMPOSE_PROJECT_NAME=clawteam
COMPOSE_FILE=docker-compose.yml

# ============================================
# 网络配置
# ============================================
CONDUIT_PORT=10000
ELEMENT_PORT=10001

# ============================================
# Human 用户配置 (Matrix 账号)
# ============================================
HUMAN_USERNAME=human
HUMAN_PASSWORD=change_me_in_production
